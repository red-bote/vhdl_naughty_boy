# Unzipped romset + compiled/converted rom-prep tools + generated PROM VHDL
# (copyrighted MAME-derived content) -- never commit, whole dir ignored.
/tools/roms/

# Generated/compiled by prep_roms.sh; live alongside the pristine .bat /
# .exe rather than in roms/, but are not themselves tracked source -- never
# commit.
/tools/make_naughty_boy_proms.sh
/tools/make_vhdl_prom

# Vivado project build tree: fully ephemeral, regenerated by
# `make create_prj clk_wiz patch` from the tracked contrib/basys3/ assets
# (.xpr, Basys-3-Master.xdc, the authored top-level .vhd).
# `make clean` removes this directory wholesale (this port has no separate
# extracted vhdl_<machine>_rev_.../ tree to remove -- the pristine source is
# this repo's own rtl_dar/rtl_T80/, tracked normally).
/basys3/
*.jou
*.log
*.str
*.wdb

# Extra safety net against committing romset zips
*.zip
